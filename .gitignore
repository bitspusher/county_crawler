# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node ---
node_modules/
npm-debug.log*
yarn-error.log*

# --- Crawler output / data / caches ---
data/
output/
downloads/
# Persistent browser profile — holds the CAPTCHA-cleared session. Never commit.
.browser_profile/
probe_out/
probe_out2/
debug/
*.sqlite
*.db
.cache/
scrapy_cache/
*.log

# --- Secrets / env ---
.env
.env.*
!.env.example
secrets.*
credentials.json

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Agent pipeline ---
# Concurrency lock, recreated per run.
.pipeline.lock
reviews/*.json.lock
# Per-run logs. The durable signals — pipeline-health.log, spec-attempts.json,
# collection-metrics.jsonl, collection-floor.json, agent-costs.jsonl,
# dismissed-findings.md, needs-human-review.md — ARE tracked, deliberately:
# they are how a later cycle knows what already happened.
reviews/*.log
!reviews/pipeline-health.log

# Harness leftovers from atomic writes of .claude/settings.local.json
.claude/settings.local.json.tmp.*
